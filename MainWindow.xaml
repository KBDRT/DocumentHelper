<Window x:Class="DocumentHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocumentHelper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        x:Name="MainShowWindow"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        >

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"></WindowChrome>
    </WindowChrome.WindowChrome>
    
    
    <Grid>

        <local:TitleBar x:Name="TitleBar" Title="Документы">
            
        </local:TitleBar>
        
        <Button Content="Документ" HorizontalAlignment="Left" Margin="29,118,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <Button Content="Заказчики" HorizontalAlignment="Left" Margin="277,118,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        <Button Content="Единицы измерения" HorizontalAlignment="Left" Margin="375,118,0,0" VerticalAlignment="Top" Click="Button_Click_2"/>
        <Button Content="Услуги и материалы" HorizontalAlignment="Left" Margin="518,118,0,0" VerticalAlignment="Top" Click="Button_Click_3"/>
        <DataGrid ItemsSource="{Binding Documents}" Margin="0,156,0,0" MouseDoubleClick="DataGrid_MouseDoubleClick"/>
    </Grid>
</Window>
