<Window x:Class="DocumentHelper.DocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Документ" 
        Height="604" 
        Width="1192"
        Language="ru-RU" 
        Name="DocumentShowWindow"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">

    <Grid Margin="16" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхний блок - информация о документе -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Effect="{StaticResource ShadowEffect}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Сист. номер:" Style="{StaticResource SmallLabelStyle}"/>
                <TextBlock Grid.Column="1" Text="0" VerticalAlignment="Center" Style="{StaticResource SummaryValueStyle}"/>

                <Label Grid.Column="2" Content="Номер:" Style="{StaticResource SmallLabelStyle}"/>
                <TextBox Grid.Column="3" Height="28" VerticalContentAlignment="Center" Text="{Binding Number, Mode=TwoWay}"/>

                <Label Grid.Column="4" Content="Дата:" Style="{StaticResource SmallLabelStyle}"/>
                <DatePicker Grid.Column="5" Style="{StaticResource VerySmallDatePicker}" SelectedDate="{Binding Date, Mode=TwoWay}"/>

                <Label Grid.Column="6" Content="Организация:" Style="{StaticResource SmallLabelStyle}"/>

                <ComboBox 
                    SelectedItem="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding ElementName=DocumentShowWindow, Path=DataContext.AvailableCustomers}"
                    DisplayMemberPath="FullInfo"
                    Grid.Column="7" Style="{StaticResource SmallComboBox}"/>

                <Label Grid.Column="8" Content="Начало:" Style="{StaticResource SmallLabelStyle}"/>
                <DatePicker Grid.Column="9" Style="{StaticResource VerySmallDatePicker}" SelectedDate="{Binding DateStart, Mode=TwoWay}"/>

                <Label Grid.Column="10" Content="Конец:" Style="{StaticResource SmallLabelStyle}"/>
                <DatePicker Grid.Column="11" Style="{StaticResource VerySmallDatePicker}" SelectedDate="{Binding DateEnd, Mode=TwoWay}"/>

                <Button Grid.Column="12" Content="Сохранить" Style="{StaticResource SuccessButton}" Height="28" Padding="12,4" Margin="8,0,0,0" Command="{Binding SaveCommand}"/>
                <Button Grid.Column="13" Content="Создать файл" Style="{StaticResource PrimaryButton}" Height="28" Padding="12,4" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Блок с итогами по разделам -->
        <Border Grid.Row="1"
                Background="{StaticResource SummaryBackgroundBrush}"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <StackPanel>
                <!-- Заголовки столбцов -->
                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                 Text="Раздел"
                 Style="{StaticResource SummaryTextStyleBox}"
                 FontWeight="Bold"
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True"
                 Focusable="False"/>

                    <TextBox Grid.Column="2"
                 Text="Сумма"
                 Style="{StaticResource SummaryValueStyleBox}"
                 FontWeight="Bold"
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True"
                 Focusable="False"/>
                </Grid>

                <!-- Итоги по разделам -->
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                             Text="{Binding Name, Mode=OneWay, StringFormat='{}{0}'}" 
                             Style="{StaticResource SummaryTextStyleBox}"
                             BorderThickness="0"
                             Background="Transparent"
                             IsReadOnly="True"
                             />

                                <TextBox Grid.Column="2"
                             Text="{Binding SectionTotalSum, Mode=OneWay, StringFormat=' {0:C}'}" 
                             Style="{StaticResource SummaryValueStyleBox}"
                         
                             BorderThickness="0"
                             Background="Transparent"
                             IsReadOnly="True"
                             />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                          Text="Накладные расходы" 
                          Style="{StaticResource SummaryTextStyleBox}"
                          BorderThickness="0"
                          Background="Transparent"
                          IsReadOnly="True"
                          />

                    <TextBox x:Name="CostTextBox"
                      Grid.Column="1"
                      Text="{Binding Costs,Mode= TwoWay, StringFormat=' {0:C}', UpdateSourceTrigger=PropertyChanged}" 
                      Style="{StaticResource SummaryValueStyleBox}"
                    />

                    <TextBox Grid.Column="2"
                          Text="{Binding CostsReal, Mode=TwoWay, StringFormat='{}({0:C})'}" 
                          Style="{StaticResource SummaryValueStyleBox}"
                          BorderThickness="0"
                          Background="Transparent"
                          ToolTip="{Binding CostsTooltip}"
                          IsReadOnly="True"
                          PreviewMouseLeftButtonUp="TextBox_MouseLeftButtonUp"
                          Cursor="Hand"
                    />
                </Grid>


                <!-- Разделительная линия -->
                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,5,0,5"/>

                <!-- Общая сумма -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                 Text="Общая сумма:" 
                 Style="{StaticResource SummaryTextStyleBox}"
                 Foreground="{StaticResource SuccessBrush}"
                 FontWeight="Bold"
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True"
                 Focusable="False"/>

                    <TextBox Grid.Column="2"
                 Text="{Binding TotalSum, StringFormat=' {0:C}'}" 
                 Style="{StaticResource SummaryValueStyleBox}"
                 Foreground="{StaticResource SuccessBrush}"
                 FontWeight="Bold"
                
                 BorderThickness="0"
                 Background="Transparent"
                 IsReadOnly="True"
                 Focusable="False"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Таблица с позициями -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                Padding="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0">

            <TabControl x:Name="MainTabControl" 
                        ItemsSource="{Binding Sections}"
                        SelectedIndex="0">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name, FallbackValue='Без названия'}" Margin="5"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <!-- Панель управления с кнопками и информацией -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,5" VerticalAlignment="Center">
                                <Button Content="Добавить позицию" 
                                        Style="{StaticResource SmallButton}"
                                        Command="{Binding AddPositionCommand}"/>

                                <Button Content="Удалить позицию" 
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding RemovePositionCommand}"
                                        Margin="8,0,0,0"/>

                                <!-- Информация о позициях и сумме -->
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" >
                                    <TextBlock Text="{Binding PositionsCount, StringFormat='Позиций: {0}'}" 
                                               Style="{StaticResource SummaryTextStyle}"/>

                                    <TextBlock Text="{Binding SectionTotalSum, StringFormat='Сумма: {0:C}', Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                               Style="{StaticResource SummaryValueStyle}"
                                               Foreground="{StaticResource SuccessBrush}" Margin="30,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Таблица -->
                            <DataGrid ItemsSource="{Binding Positions}"
                                     AutoGenerateColumns="False"
                                     Style="{StaticResource ModernDataGrid}"
                                     ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                     CellStyle="{StaticResource DataGridCellStyle}"
                                     SelectedItem="{Binding SelectedPosition}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№ п/п" Width="70" Binding="{Binding Number}" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Item.Name}"/>
                                    <DataGridTextColumn Header="Ед.измерения" Width="120" Binding="{Binding Item.Unit.ShortName}"/>

                                    <DataGridTextColumn Header="Количество" Width="120" 
                                                       Binding="{Binding Amount, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       ElementStyle="{StaticResource RightAlignedCellStyle}" 
                                                       EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>

                                    <DataGridTextColumn Header="Цена" Width="140" 
                                                       Binding="{Binding Price, StringFormat=C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                       ElementStyle="{StaticResource RightAlignedCellStyle}" 
                                                       EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>

                                    <DataGridTextColumn Header="Сумма" Width="140" 
                                                       Binding="{Binding TotalSum, StringFormat=C}" 
                                                       IsReadOnly="True" 
                                                       ElementStyle="{StaticResource RightAlignedCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>
    </Grid>
</Window>