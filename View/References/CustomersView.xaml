<Window x:Class="DocumentHelper.View.References.CustomersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Заказчики" 
        Height="604" 
        Width="1192"
        Language="ru-RU" 
        WindowStartupLocation="CenterScreen" WindowState="Normal">

    <Grid Margin="6" Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Таблица с позициями -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                Padding="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0">

            <DockPanel>
                <!-- Верхняя панель с кнопками -->
                <Grid DockPanel.Dock="Top" Margin="10,10,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая группа кнопок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Добавить единицу" 
        Style="{StaticResource SmallButton}"
        Command="{Binding AddPositionCommand}"/>

                        <Button Content="Удалить единицу" 
        Style="{StaticResource DangerButton}"
        Command="{Binding RemovePositionCommand}"
        Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- Центральная информация -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PositionsCount, StringFormat='Позиций: {0}'}" 
           Style="{StaticResource SummaryTextStyle}"/>

                        <TextBlock Text="{Binding SectionTotalSum, StringFormat='Сумма: {0:C}', Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
           Style="{StaticResource SummaryValueStyle}"
           Foreground="{StaticResource SuccessBrush}" Margin="30,0,0,0"/>
                    </StackPanel>

                    <!-- Правая группа с кнопкой Сохранить -->
                    <Button Grid.Column="2" Content="Сохранить" 
                Style="{StaticResource SuccessButton}"
                Command="{Binding SaveCommand}"
                HorizontalAlignment="Right"
                />
                </Grid>

                <!-- Таблица -->
                <DataGrid ItemsSource="{Binding Positions}"
                  AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGrid}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  SelectedItem="{Binding SelectedPosition}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding Item.Name}"/>
                        <DataGridTextColumn Header="Город" Width="*" Binding="{Binding Item.Unit.ShortName}"/>

                        <DataGridTextColumn Header="Улица" Width="*" 
                               Binding="{Binding Amount, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               ElementStyle="{StaticResource RightAlignedCellStyle}" 
                               EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>

                        <DataGridTextColumn Header="Дом" Width="140" 
                               Binding="{Binding Price, StringFormat=C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                               ElementStyle="{StaticResource RightAlignedCellStyle}" 
                               EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>

                        <DataGridTextColumn Header="Дата начала" Width="140" 
                            Binding="{Binding Price, StringFormat=C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            ElementStyle="{StaticResource RightAlignedCellStyle}" 
                            EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>

                                            <DataGridTextColumn Header="Дата окончания" Width="140" 
                            Binding="{Binding Price, StringFormat=C, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            ElementStyle="{StaticResource RightAlignedCellStyle}" 
                            EditingElementStyle="{StaticResource RightAlignedEditStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>


        </Border>
    </Grid>
</Window>