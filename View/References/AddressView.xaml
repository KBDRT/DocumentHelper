<Window x:Class="DocumentHelper.View.References.AddressView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:DocumentHelper"
        mc:Ignorable="d"
        Title="Адреса" 
        Height="650" 
        Width="700"
        Language="ru-RU" 
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        >

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"></WindowChrome>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource TextBrush}" 
        BorderThickness="1"
        Background="White">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:TitleBar Title="Адреса">

            </local:TitleBar>

            <!-- Таблица с позициями -->
            <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                Margin="12,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0" Cursor="">

                <DockPanel Cursor="">
                    <!-- Верхняя панель с кнопками -->
                    <Grid DockPanel.Dock="Top" Margin="10,4,10,5">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Label Grid.Column="0" Grid.Row="0" Content="Адреса для заказчика:" Style="{StaticResource SmallLabelStyle}"/>
                            <TextBox Grid.Column="1" Grid.Row="0" Height="28" VerticalContentAlignment="Center" Text="{Binding Customer.FullInfo, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                        
                        <!-- Левая группа кнопок -->
                        <StackPanel  Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Cursor="">

                            <Button Content="Выбрать адрес" 
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SelectCommand}" Cursor="Hand"
                                Visibility="{Binding IsVisibleSelectButton}"
                            />

                            <Button Content="Сохранить"  Margin="50,0,0,0"
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SaveCommand}" Cursor="Hand"
                            />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Добавить адрес" 
                                Style="{StaticResource SmallButton}"
                                Command="{Binding AddCommand}"
                            />

                                <Button Content="Удалить адрес" 
                                Style="{StaticResource DangerButton}"
                                Command="{Binding RemoveCommand}"
                                Cursor="Hand"
                            />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Таблица -->
                    <DataGrid ItemsSource="{Binding AddressesView}"
                      AutoGenerateColumns="False"
                      Style="{StaticResource ModernDataGrid2}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle2}"
                      CellStyle="{StaticResource DataGridCellStyle2}"
                      SelectedItem="{Binding SelectedItem}"
                      AlternatingRowBackground="White"
                      HorizontalGridLinesBrush="Transparent"
                      ColumnHeaderHeight="32"
                      Margin="0,0,0,12"
                      >

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Полный адрес для записи в поле объект" Width="*" Binding="{Binding FullAddress, Mode=TwoWay}"/>
                            <!--<DataGridTextColumn Header="Краткое наименование" Width="*" Binding="{Binding ShortName, Mode=TwoWay}"/>-->
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>