<Window x:Class="DocumentHelper.View.Validation.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибки" Height="300" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Обнаружены следующие ошибки:" 
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1" Name="ErrorsGrid" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True">
            <DataGrid.Columns>
                <!--<DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>-->
                <DataGridTextColumn Header="Сообщение" Binding="{Binding ErrorMessage}" Width="*"/>
                <!--<DataGridTextColumn Header="Поле" Binding="{Binding Field}" Width="100"/>-->
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Закрыть" 
                Click="CloseButton_Click" 
                Width="100" Height="30" 
                HorizontalAlignment="Right" 
                Margin="0,10,0,0"/>
    </Grid>
</Window>
