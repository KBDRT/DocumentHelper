<Window x:Class="DocumentHelper.View.References.CustomersView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:DocumentHelper"
        mc:Ignorable="d"
        Title="Заказчики" 
        Height="650" 
        Width="1000"
        Language="ru-RU" 
        WindowStartupLocation="CenterScreen" WindowState="Normal"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"></WindowChrome>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource TextBrush}" 
        BorderThickness="1"
        Background="White">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:TitleBar Title="Заказчики">

            </local:TitleBar>

            <!-- Таблица с позициями -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="6"
                Margin="12,0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0" Cursor="">

            <DockPanel>
                <!-- Верхняя панель с кнопками -->
                <Grid DockPanel.Dock="Top" Margin="10,4,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая группа кнопок -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="">

                            <Button Content="Сохранить" 
                                Style="{StaticResource SuccessButton}"
                                Command="{Binding SaveCommand}" Cursor="Hand"
                            />
                        
                            <StackPanel Orientation="Horizontal" Margin="50,0">
                                <Button Content="Добавить заказчика" 
                                    Style="{StaticResource SmallButton}"
                                    Command="{Binding AddCommand}"
                                />

                                <Button Content="Удалить заказчика" 
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding RemoveCommand}"
                                    Cursor="Hand"
                                />
                            </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Таблица -->
                <DataGrid ItemsSource="{Binding Reference}"
                  AutoGenerateColumns="False"
                  Style="{StaticResource ModernDataGrid2}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle2}"
                  CellStyle="{StaticResource DataGridCellStyle2}"
                  SelectedItem="{Binding SelectedItem}"
                  AlternatingRowBackground="White"
                  HorizontalGridLinesBrush="Transparent"
                  ColumnHeaderHeight="32"
                  Margin="0,0,0,12"
                  >

                    <DataGrid.Columns>
                        <!--<DataGridTextColumn Header="№ п/п" Width="70" Binding="{Binding Number, Mode=OneWay}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>-->

                        <DataGridTextColumn Header="Полное наименование" Width="1.5*" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        
                        <DataGridTemplateColumn Header="Адреса" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="Открыть объекты" 
                                    TextDecorations="Underline"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="OpenDetails_MouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Договора" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="Открыть договора" 
                                        TextDecorations="Underline"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="OpenDetails_MouseLeftButtonDown_1"/>     
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>


                            <!--<DataGridTextColumn Header="Населенный пункт" Width="1.5*" Binding="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                        <!--<DataGridTextColumn Header="Улица" Width="1.25*" Binding="{Binding Street, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                        <!--<DataGridTextColumn Header="Дом" Width="0.8*" Binding="{Binding House, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>-->
                        <!--<DataGridTemplateColumn Header="Дата начала" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding DateStart, Mode=TwoWay}"
                                       BorderThickness="0"
                                       Background="Transparent"/>       
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Дата окончания" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding DateEnd, Mode=TwoWay}"
                                        BorderThickness="0"
                                        Background="Transparent"/>       
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>-->
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        </Grid>
    </Border>
</Window>